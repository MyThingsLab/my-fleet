# Deployed on the Pi (lollinuxpi-server), checkout at ~/repos/MyThingsLab.
#
# Copied back from the live /etc/systemd/system/fleet-cycle.service, which had
# drifted from this file: it runs --execute --dispatch-execute under the GitHub
# App with --ask-human, and it does NOT pass --skip-bookkeeping. So this is one
# full tick every 6h, not the build/bookkeeping split the README described --
# fleet-bookkeeping.timer was never installed. That matters to the heartbeat:
# fleet_cycle records the 'bookkeeping' tick whenever it wasn't told to skip it,
# so this single unit feeds both heartbeats and installing fleet-bookkeeping
# alongside it would just run the ~50-repo fan-out twice.
[Unit]
Description=MyThingsLab fleet cycle (live)
After=network-online.target
Wants=network-online.target
OnFailure=telegram-alert@%n.service

[Service]
Type=oneshot
# Type=oneshot defaults TimeoutStartSec to infinity, which is how a single
# `accept --settle --ask-human` pass sat in activating(start) for 4h41m on
# 2026-09-17. A timer will not re-trigger a service that is still active, so an
# overrunning run leaves fleet-cycle.timer at `Trigger: n/a` -- no next run
# scheduled at all. Below the 6h period, so a wedged tick is killed (and, via
# OnFailure=, announced) before the one after it is due. The ask budget in
# myfleet.accept bounds the known cause; this bounds the next one.
TimeoutStartSec=5h
User=lollinuxpi
WorkingDirectory=/home/lollinuxpi/repos/MyThingsLab/my-fleet
Environment=PATH=/home/lollinuxpi/repos/MyThingsLab/.venv/bin:/usr/bin:/bin
Environment=FLEET_ACCOUNTS=/home/lollinuxpi/.claude-personal,/home/lollinuxpi/.claude-work
EnvironmentFile=-/home/lollinuxpi/.config/mythingslab/telegram.env
ExecStart=/home/lollinuxpi/repos/MyThingsLab/my-fleet/run_fleet_cycle.sh --execute --dispatch-execute --app-id 4919696 --app-installation-id 161109462 --app-private-key /home/lollinuxpi/.config/mythingslab/github-app.pem --ask-human
