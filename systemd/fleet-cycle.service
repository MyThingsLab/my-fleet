# Deployed on the Pi (lollinuxpi-server), checkout at ~/repos/MyThingsLab.
[Unit]
Description=MyThingsLab fleet cycle (dry-run)
After=network-online.target
Wants=network-online.target
OnFailure=telegram-alert@%n.service

[Service]
Type=oneshot
User=lollinuxpi
WorkingDirectory=/home/lollinuxpi/repos/MyThingsLab/my-fleet
Environment=PATH=/home/lollinuxpi/repos/MyThingsLab/.venv/bin:/usr/bin:/bin
Environment=FLEET_ACCOUNTS=/home/lollinuxpi/.claude-personal,/home/lollinuxpi/.claude-work
EnvironmentFile=-/home/lollinuxpi/.config/mythingslab/telegram.env
ExecStart=/home/lollinuxpi/repos/MyThingsLab/my-fleet/run_fleet_cycle.sh --skip-bookkeeping
